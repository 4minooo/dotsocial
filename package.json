{
  "name": "dot-social",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5190 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4190 --strictPort",
    "test": "vitest run",
    "check": "npm run test && npm run build",
    "test:browser": "playwright test",
    "test:rules": "node --test tests/rules.mjs",
    "emulators": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/emulators.ps1",
    "emulators:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/emulators.ps1 -Test",
    "rules:generate": "node scripts/generate-rules.mjs",
    "format": "prettier --write src tests *.ts *.json *.md scripts/*.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^9.0.0",
    "firebase": "^13.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-tools": "^15.33.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "@opentelemetry/core": "^2.12.0",
    "basic-ftp": "^6.2.2",
    "uuid": "^11.1.1",
    "chokidar": "^4.0.3"
  }
}
